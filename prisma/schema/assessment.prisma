model Assessment {
  id          String               @id @default(uuid())
  title       String
  description String?
  accessType  AssessmentAccessType @default(FREE)
  price       Decimal?             @db.Decimal(10, 2)
  status      AssessmentStatus     @default(DRAFT)
  createdById String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation(fields: [createdById], references: [id])
  payments    Payment[]
  problems    Problem[]
  results     Result[]

  @@index([createdById])
  @@index([accessType])
  @@index([status])
  @@map("assessments")
}
