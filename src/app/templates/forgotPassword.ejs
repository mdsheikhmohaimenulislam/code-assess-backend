
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset - Code Assess System</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family: Arial, Helvetica, sans-serif;
        color: #333333;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #2563eb;
        padding: 28px 30px;
        text-align: center;
      }

      .header h1 {
        margin: 0;
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
      }

      .content {
        padding: 35px 30px;
      }

      .content h2 {
        margin: 0 0 15px;
        color: #222222;
        font-size: 22px;
      }

      .content p {
        margin: 12px 0;
        font-size: 15px;
        line-height: 1.7;
        color: #555555;
      }

      .otp-wrapper {
        text-align: center;
        margin: 28px 0;
      }

      .otp {
        display: inline-block;
        padding: 14px 28px;
        background-color: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        color: #2563eb;
        font-size: 30px;
        font-weight: 700;
        letter-spacing: 8px;
      }

      .expiry {
        text-align: center;
        margin-top: 20px;
        padding: 12px;
        background-color: #fff7ed;
        border-radius: 6px;
        color: #9a3412;
        font-size: 13px;
      }

      .security-note {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        font-size: 13px !important;
        color: #777777 !important;
      }

      .footer {
        padding: 20px 30px;
        background-color: #f8fafc;
        text-align: center;
        border-top: 1px solid #eeeeee;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        color: #888888;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 28px 20px;
        }

        .header {
          padding: 24px 20px;
        }

        .otp {
          font-size: 24px;
          letter-spacing: 6px;
          padding: 12px 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <h1>Code Assess System</h1>
        </div>

        <!-- Content -->
        <div class="content">
          <h2>Password Reset Request</h2>

          <p>
            Hello <strong><%= name %></strong>,
          </p>

          <p>
            We received a request to reset the password associated with your
            Code Assess System account.
          </p>

          <p>
            Please use the verification code below to reset your password:
          </p>

          <!-- OTP -->
          <div class="otp-wrapper">
            <div class="otp"><%= otp %></div>
          </div>

          <!-- Expiration -->
          <div class="expiry">
            This verification code will expire in
            <strong><%= expirationMinutes %> minutes</strong>.
          </div>

          <p>
            For your security, please do not share this code with anyone.
          </p>

          <p class="security-note">
            If you did not request a password reset, you can safely ignore
            this email. Your account will remain secure.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>&copy; <%= new Date().getFullYear() %> Code Assess System.</p>
          <p>All rights reserved.</p>
        </div>

      </div>
    </div>
  </body>
</html>

