<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email - Code Assess</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 16px;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
      }

      .header {
        padding: 28px 32px;
        text-align: center;
        background-color: #111827;
      }

      .logo {
        margin: 0;
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
      }

      .logo span {
        color: #60a5fa;
      }

      .content {
        padding: 40px 36px;
      }

      .title {
        margin: 0 0 16px;
        font-size: 24px;
        line-height: 1.3;
        font-weight: 700;
        color: #111827;
      }

      .text {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      .otp-wrapper {
        margin: 30px 0;
        padding: 24px;
        text-align: center;
        background-color: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
      }

      .otp-label {
        margin: 0 0 12px;
        font-size: 13px;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      .otp {
        margin: 0;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 8px;
        color: #2563eb;
      }

      .expiry {
        margin: 0;
        font-size: 14px;
        line-height: 1.6;
        color: #6b7280;
      }

      .warning {
        margin-top: 24px;
        padding: 14px 16px;
        background-color: #fff7ed;
        border-left: 4px solid #f97316;
        border-radius: 4px;
        font-size: 13px;
        line-height: 1.6;
        color: #7c2d12;
      }

      .footer {
        padding: 24px 32px;
        text-align: center;
        background-color: #f9fafb;
        border-top: 1px solid #e5e7eb;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        line-height: 1.5;
        color: #9ca3af;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 12px;
        }

        .content {
          padding: 30px 22px;
        }

        .header {
          padding: 24px 20px;
        }

        .title {
          font-size: 21px;
        }

        .otp {
          font-size: 28px;
          letter-spacing: 6px;
        }

        .footer {
          padding: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <h1 class="logo">Code<span>Assess</span></h1>
        </div>

        <!-- Main Content -->
        <div class="content">
          <h2 class="title">Verify Your Email Address</h2>

          <p class="text">Hello <strong><%= name %></strong>,</p>

          <p class="text">
            Thank you for registering with Code Assess. To complete your
            registration and verify your email address
            <strong><%= email %></strong>, please use the verification code
            below.
          </p>

          <!-- OTP -->
          <div class="otp-wrapper">
            <p class="otp-label">Verification Code</p>
            <p class="otp"><%= otp %></p>
          </div>

          <p class="expiry">
            This verification code will expire in
            <strong><%= expirationMinutes %> minutes</strong>.
          </p>

          <div class="warning">
            <strong>Security notice:</strong>
            If you did not create an account or request this verification code,
            you can safely ignore this email. Never share your OTP with anyone.
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            This is an automated message. Please do not reply to this email.
          </p>

          <p>&copy; <%= year %> Code Assess. All rights reserved.</p>
        </div>
      </div>
    </div>
  </body>
</html>
