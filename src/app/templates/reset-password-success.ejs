<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Successful - Code Assess System</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f4f6f8;
        font-family: Arial, Helvetica, sans-serif;
        color: #333333;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
        box-sizing: border-box;
      }

      .container {
        max-width: 520px;
        margin: 0 auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      }

      .header {
        background-color: #2563eb;
        padding: 28px 30px;
        text-align: center;
      }

      .header h1 {
        margin: 0;
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
      }

      .content {
        padding: 35px 30px;
        text-align: center;
      }

      .success-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 22px;
        border-radius: 50%;
        background-color: #dcfce7;
        color: #16a34a;
        font-size: 32px;
        font-weight: bold;
        line-height: 58px;
      }

      .content h2 {
        margin: 0 0 15px;
        color: #222222;
        font-size: 22px;
      }

      .content p {
        margin: 12px 0;
        font-size: 15px;
        line-height: 1.7;
        color: #555555;
      }

      .account-message {
        margin-top: 25px;
        padding: 16px;
        background-color: #eff6ff;
        border-radius: 8px;
        color: #1e40af !important;
        font-size: 14px !important;
      }

      .security-note {
        margin-top: 25px !important;
        padding-top: 20px;
        border-top: 1px solid #eeeeee;
        font-size: 13px !important;
        color: #777777 !important;
      }

      .footer {
        padding: 20px 30px;
        background-color: #f8fafc;
        text-align: center;
        border-top: 1px solid #eeeeee;
      }

      .footer p {
        margin: 4px 0;
        font-size: 12px;
        color: #888888;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 28px 20px;
        }

        .header {
          padding: 24px 20px;
        }

        .header h1 {
          font-size: 21px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">
        <!-- Header -->
        <div class="header">
          <h1>Code Assess System</h1>
        </div>

        <!-- Content -->
        <div class="content">
          <div class="success-icon">&#10003;</div>

          <h2>Password Reset Successful</h2>

          <p>Hello <strong><%= name %></strong>,</p>

          <p>
            Your Code Assess System account password has been successfully
            changed.
          </p>

          <div class="account-message">
            You can now sign in to your account using your new password.
          </div>

          <p class="security-note">
            If you did not make this change, please contact our support team
            immediately to protect your account.
          </p>
        </div>

        <!-- Footer -->
        <div class="footer">
          <p>&copy; <%= new Date().getFullYear() %> Code Assess System.</p>
          <p>All rights reserved.</p>
        </div>
      </div>
    </div>
  </body>
</html>
